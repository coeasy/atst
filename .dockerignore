.git
.gitignore

# Local Python environments and caches
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
.coverage.*
coverage.xml
htmlcov

# Local packaging/build outputs. Normal Docker builds create a fresh wheel in the
# builder. Release builds are the one exception: the workflow downloads the
# already-validated canonical wheel into release-dist/ and Dockerfile.release
# must receive that exact artifact.
build
dist
*.egg-info
*.whl
*.tar.gz
!release-dist/*.whl

# Local editor/OS noise
.DS_Store
Thumbs.db
.idea
.vscode

# Generated audit/benchmark outputs are not Docker build inputs.
audit_report.json
audit_summary.md
benches/results
